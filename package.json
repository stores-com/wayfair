{
    "dependencies": {
        "@stores.com/http-error": "~1.2.0",
        "memory-cache": "~0.2.0"
    },
    "description": "A Node.js client for Wayfair's dropship inventory API.",
    "devDependencies": {
        "@eslint/js": "*",
        "eslint": "*",
        "globals": "*"
    },
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "dropship",
        "inventory",
        "supplier",
        "wayfair"
    ],
    "license": "MIT",
    "main": "index.js",
    "name": "@stores.com/wayfair",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stores-com/wayfair.git"
    },
    "scripts": {
        "test": "node --test --test-force-exit --test-reporter=spec test/*.js",
        "test:coverage": "node --test --test-force-exit --experimental-test-coverage --test-reporter=spec test/*.js",
        "test:only": "node --test --test-force-exit --test-only --test-reporter=spec test/*.js"
    },
    "version": "0.1.0"
}
